<Window x:Class="FileTabs.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="FileTabs 设置" Height="280" Width="480"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        FontFamily="{x:Static SystemFonts.MessageFontFamily}"
        FontSize="{x:Static SystemFonts.MessageFontSize}">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="主题"/>
        <ComboBox Grid.Row="1" x:Name="ThemeCombo" Margin="0,6,0,0"
                  SelectedIndex="2" Height="30">
            <ComboBoxItem Content="浅色"/>
            <ComboBoxItem Content="深色"/>
            <ComboBoxItem Content="跟随系统"/>
        </ComboBox>

        <TextBlock Grid.Row="2" Text="新标签页默认路径"
                   Foreground="{DynamicResource Fluent.Text}"/>
        <DockPanel Grid.Row="3" Margin="0,6,0,0">
            <Button DockPanel.Dock="Right" Content="浏览…" Width="64"
                    Click="Browse_Click" Margin="6,0,0,0"/>
            <TextBox x:Name="NewTabPathBox" Height="28" VerticalContentAlignment="Center"/>
        </DockPanel>

        <CheckBox Grid.Row="4" x:Name="ShowBookmarkBarCheckBox" Content="显示书签栏"
                  Margin="0,12,0,0"
                  Foreground="{DynamicResource Fluent.Text}"/>

        <CheckBox Grid.Row="5" x:Name="ShowPreviewPaneCheckBox" Content="显示预览面板"
                  Margin="0,8,0,0"
                  Foreground="{DynamicResource Fluent.Text}"/>

        <CheckBox Grid.Row="6" x:Name="SearchSortByNameCheckBox" Content="Everything 搜索结果按文件名排序"
                  Margin="0,8,0,0"
                  Foreground="{DynamicResource Fluent.Text}"/>

        <StackPanel Grid.Row="7" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="确定" Width="72" Height="28" IsDefault="True" Click="Ok_Click"/>
            <Button Content="取消" Width="72" Height="28" IsCancel="True" Margin="6,0,0,0"/>
        </StackPanel>
    </Grid>
</Window>
