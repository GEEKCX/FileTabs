<Window x:Class="FileTabs.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="FileTabs 设置" Width="560" Height="640"
        WindowStartupLocation="CenterOwner"
        MaxHeight="720"
        MinHeight="340"
        ResizeMode="CanResize"
        ShowInTaskbar="False"
        Background="{DynamicResource SolidBackgroundFillColorBaseBrush}"
        Foreground="{DynamicResource TextFillColorPrimaryBrush}"
        FontFamily="{x:Static SystemFonts.MessageFontFamily}"
        FontSize="{x:Static SystemFonts.MessageFontSize}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <ScrollViewer Grid.Row="0"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="16,12,16,16">
            <TextBlock Text="外观" FontWeight="SemiBold"/>
            <TextBlock Text="主题" Margin="0,8,0,0"/>
            <ComboBox x:Name="ThemeCombo" Margin="0,6,0,0"
                      SelectedIndex="2" Height="30">
                <ComboBoxItem Content="浅色"/>
                <ComboBoxItem Content="深色"/>
                <ComboBoxItem Content="跟随系统"/>
            </ComboBox>
            <CheckBox x:Name="ShowPreviewPaneCheckBox" Content="显示预览面板"
                      Margin="0,14,0,0"
                      Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
            <CheckBox x:Name="ShowNativeCommandBarCheckBox" Content="显示原生命令栏"
                      Margin="0,8,0,0"
                      Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
            <TextBlock Text="显示 Windows Explorer 自带的“新建 / 复制 / 排序 / 查看”等命令按钮。"
                       Margin="28,2,0,0" TextWrapping="Wrap" Opacity="0.7"/>

            <TextBlock Text="启动" FontWeight="SemiBold" Margin="0,22,0,0"/>
            <CheckBox x:Name="StartWithWindowsCheckBox"
                      Content="登录 Windows 时自动启动 FileTabs"
                      Margin="0,10,0,0"
                      Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
            <CheckBox x:Name="RestoreLastSessionCheckBox"
                      Content="启动时恢复上次打开的标签页"
                      Margin="0,8,0,0"
                      Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>

            <TextBlock Text="新标签页" FontWeight="SemiBold" Margin="0,22,0,0"/>
            <TextBlock Text="默认路径" Margin="0,8,0,0"/>
            <Grid Margin="0,6,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBox x:Name="NewTabPathBox" Height="28" VerticalContentAlignment="Center"/>
                <Button Grid.Column="1" Content="浏览…" Width="64" Height="28"
                        Click="Browse_Click" Margin="6,0,0,0"/>
            </Grid>

            <TextBlock Text="系统集成" FontWeight="SemiBold" Margin="0,22,0,0"/>
            <CheckBox x:Name="CaptureExplorerCheckBox"
                      Content="接管新打开的文件资源管理器窗口"
                      Margin="0,10,0,0"
                      Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
            <TextBlock Text="Win+E / 双击文件夹打开的资源管理器窗口会转为 FileTabs 标签页；按住 Ctrl+Shift 打开可临时绕过。"
                       Margin="28,2,0,0" TextWrapping="Wrap" Opacity="0.7"/>
            <CheckBox x:Name="RedirectFoldersCheckBox"
                      Content="双击文件夹 / 驱动器时用 FileTabs 打开"
                      Margin="0,12,0,0"
                      Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
            <TextBlock Text="通过当前用户的注册表重定向，无需管理员权限，可随时取消。"
                       Margin="28,2,0,0" TextWrapping="Wrap" Opacity="0.7"/>
            <TextBlock Text="打开终端时使用" Margin="0,14,0,0"/>
            <ComboBox x:Name="TerminalCombo" Margin="0,6,0,0"
                      SelectedIndex="0" Height="30">
                <ComboBoxItem Content="Windows Terminal"/>
                <ComboBoxItem Content="PowerShell"/>
                <ComboBoxItem Content="命令提示符"/>
            </ComboBox>
            <TextBlock Text="Windows Terminal 不可用时自动回退到命令提示符。"
                       Margin="0,2,0,0" TextWrapping="Wrap" Opacity="0.7"/>

            <TextBlock Text="搜索与拖放" FontWeight="SemiBold" Margin="0,22,0,0"/>
            <CheckBox x:Name="SearchSortByNameCheckBox"
                      Content="Everything 搜索结果按文件名排序"
                      Margin="0,10,0,0"
                      Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
            <CheckBox x:Name="DropPointEnabledCheckBox"
                      Content="启用拖放中转（Shift+CapsLock 唤起临时托盘点）"
                      Margin="0,8,0,0"
                      Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>

            </StackPanel>
        </ScrollViewer>
        <Border Grid.Row="1" Padding="16,10,16,12"
                BorderBrush="{DynamicResource DividerStrokeColorDefaultBrush}"
                BorderThickness="0,1,0,0">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="确定" Width="72" Height="28" IsDefault="True" Click="Ok_Click"/>
                <Button Content="取消" Width="72" Height="28" IsCancel="True" Margin="6,0,0,0"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
