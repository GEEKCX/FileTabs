<Window x:Class="FileTabs.WorkspaceWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="工作区" Height="360" Width="420"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Background="{DynamicResource SolidBackgroundFillColorBaseBrush}"
        Foreground="{DynamicResource TextFillColorPrimaryBrush}"
        FontFamily="{x:Static SystemFonts.MessageFontFamily}"
        FontSize="{x:Static SystemFonts.MessageFontSize}">
    <DockPanel Margin="12">
        <TextBlock DockPanel.Dock="Top" Text="命名工作区"
                   Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
        <TextBlock DockPanel.Dock="Top" Margin="0,4,0,0"
                   Text="保存当前打开的标签组，之后可一键恢复。"
                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
        <ListBox x:Name="WorkspaceList" Margin="0,10,0,0"
                 HorizontalContentAlignment="Stretch" BorderThickness="1"
                 BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Margin="4">
                            <TextBlock Text="{Binding Name}"
                                       Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                            <TextBlock FontSize="11"
                                       Text="{Binding Summary}"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                        </StackPanel>
                        <Button Grid.Column="1" Content="删除" Width="56" Height="24"
                                VerticalAlignment="Center" Margin="0,0,4,0"
                                Click="DeleteWorkspace_Click"/>
                    </Grid>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal"
                    HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button Content="打开" Width="72" Height="28" IsDefault="True" Click="Open_Click"/>
            <Button Content="关闭" Width="72" Height="28" IsCancel="True" Margin="6,0,0,0"/>
        </StackPanel>
    </DockPanel>
</Window>
