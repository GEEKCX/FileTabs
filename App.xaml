<Application x:Class="FileTabs.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             StartupUri="MainWindow.xaml">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ui:ThemesDictionary Theme="Light" />
                <ui:ControlsDictionary />
            </ResourceDictionary.MergedDictionaries>

        <!-- Fluent-inspired light theme. Windows shell controls (the
             ExplorerBrowser content itself) keep following the system theme,
             so only the WPF chrome around it is themed here. -->
        <SolidColorBrush x:Key="Fluent.Background" Color="#FFF3F3F3"/>
        <SolidColorBrush x:Key="Fluent.Surface" Color="#FFFFFFFF"/>
        <SolidColorBrush x:Key="Fluent.Border" Color="#19000000"/>
        <SolidColorBrush x:Key="Fluent.Text" Color="#FF1B1B1B"/>
        <SolidColorBrush x:Key="Fluent.TextSecondary" Color="#FF6F6F6F"/>
        <SolidColorBrush x:Key="Fluent.Accent" Color="#FF0067C0"/>
        <SolidColorBrush x:Key="Fluent.AccentHover" Color="#FF1A74C7"/>
        <SolidColorBrush x:Key="Fluent.AccentPressed" Color="#FF005BA1"/>
        <SolidColorBrush x:Key="Fluent.Hover" Color="#0F000000"/>
        <SolidColorBrush x:Key="Fluent.Checked" Color="#16000000"/>
        <SolidColorBrush x:Key="Fluent.Danger" Color="#FFE81123"/>

        <Style TargetType="Button">
            <Setter Property="Foreground" Value="{DynamicResource Fluent.Text}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Padding" Value="10,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bg" Background="{DynamicResource Fluent.Surface}"
                                BorderBrush="{DynamicResource Fluent.Border}"
                                BorderThickness="1" CornerRadius="4">
                            <ContentPresenter Margin="{TemplateBinding Padding}"
                                              HorizontalAlignment="Center" VerticalAlignment="Center"
                                              RecognizesAccessKey="True"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bg" Property="Background"
                                        Value="{DynamicResource Fluent.Hover}"/>
                                <Setter TargetName="bg" Property="BorderBrush"
                                        Value="{DynamicResource Fluent.Accent}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bg" Property="Background"
                                        Value="{DynamicResource Fluent.Checked}"/>
                                <Setter TargetName="bg" Property="BorderBrush"
                                        Value="{DynamicResource Fluent.AccentPressed}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Ghost / icon-only toolbar buttons: no chrome until hovered. -->
        <Style x:Key="Fluent.IconButton" TargetType="Button">
            <Setter Property="Foreground" Value="{DynamicResource Fluent.Text}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bg" Background="Transparent" CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bg" Property="Background"
                                        Value="{DynamicResource Fluent.Hover}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bg" Property="Background"
                                        Value="{DynamicResource Fluent.Checked}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="Fluent.PrimaryButton" TargetType="Button">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Padding" Value="10,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bg" Background="{DynamicResource Fluent.Accent}" CornerRadius="4">
                            <ContentPresenter Margin="{TemplateBinding Padding}"
                                              HorizontalAlignment="Center" VerticalAlignment="Center"
                                              RecognizesAccessKey="True"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bg" Property="Background"
                                        Value="{DynamicResource Fluent.AccentHover}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bg" Property="Background"
                                        Value="{DynamicResource Fluent.AccentPressed}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ToggleButton">
            <Setter Property="Foreground" Value="{DynamicResource Fluent.Text}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="bg" Background="Transparent" CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bg" Property="Background"
                                        Value="{DynamicResource Fluent.Hover}"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="bg" Property="Background"
                                        Value="{DynamicResource Fluent.Checked}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="TextBox">
            <Setter Property="Foreground" Value="{DynamicResource Fluent.Text}"/>
            <Setter Property="CaretBrush" Value="{DynamicResource Fluent.Text}"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Padding" Value="8,0"/>
            <Setter Property="SelectionBrush" Value="{DynamicResource Fluent.Accent}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="bg" Background="{DynamicResource Fluent.Surface}"
                                BorderBrush="{DynamicResource Fluent.Border}"
                                BorderThickness="1" CornerRadius="4">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}"
                                          VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bg" Property="BorderBrush"
                                        Value="{DynamicResource Fluent.Accent}"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="bg" Property="BorderBrush"
                                        Value="{DynamicResource Fluent.Accent}"/>
                                <Setter TargetName="bg" Property="BorderThickness" Value="2"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Flat menu item inside the hamburger popup. -->
        <Style x:Key="Fluent.MenuItem" TargetType="MenuItem">
            <Setter Property="Foreground" Value="{DynamicResource Fluent.Text}"/>
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="MenuItem">
                        <Border x:Name="bg" Background="Transparent" CornerRadius="3"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter ContentSource="Header" RecognizesAccessKey="True"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="bg" Property="Background"
                                        Value="{DynamicResource Fluent.Hover}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        </ResourceDictionary>
    </Application.Resources>
</Application>
