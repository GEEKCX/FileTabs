<UserControl x:Class="FileTabs.DirectoryCleanupPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <Style x:Key="PageCard" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource FileTabs.SettingsCardBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource FileTabs.SettingsCardBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="16"/>
        </Style>

        <Style x:Key="SectionTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>

        <Style x:Key="PageHint" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Margin" Value="0,4,0,0"/>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Style="{StaticResource PageCard}">
            <StackPanel>
                <DockPanel>
                    <TextBlock Text="目录清理" Style="{StaticResource SectionTitle}"/>
                    <TextBlock x:Name="ScanStatusText" DockPanel.Dock="Right"
                               HorizontalAlignment="Right" VerticalAlignment="Center"
                               Style="{StaticResource PageHint}" Margin="8,0,0,0"/>
                </DockPanel>
                <TextBlock x:Name="FolderText" Style="{StaticResource PageHint}"/>

                <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                    <CheckBox x:Name="RecursiveCheck" Content="包含子目录"
                              IsChecked="True" VerticalAlignment="Center"/>
                    <CheckBox x:Name="IncludeHiddenCheck" Content="包含隐藏项"
                              Margin="16,0,0,0" VerticalAlignment="Center"/>
                    <TextBlock Text="大文件数量" Margin="20,0,8,0" VerticalAlignment="Center"/>
                    <TextBox x:Name="LargestCountBox" Width="56" Height="30" Text="50"
                             VerticalContentAlignment="Center"/>
                    <TextBlock Text="超期天数" Margin="16,0,8,0" VerticalAlignment="Center"/>
                    <TextBox x:Name="StaleDaysBox" Width="56" Height="30" Text="90"
                             VerticalContentAlignment="Center"/>
                    <Button x:Name="ScanButton" Content="重新扫描" Height="30"
                            Margin="16,0,0,0" Click="Scan_Click"/>
                </StackPanel>

                <TextBlock Text="“空文件夹”只列出当前完全为空的目录；删除后上一级可能变空，重新扫描即可看到。所有删除都进入回收站。"
                           Style="{StaticResource PageHint}"/>
            </StackPanel>
        </Border>

        <ProgressBar x:Name="ScanProgress" Grid.Row="1" Height="3" Margin="0,8,0,0"
                     IsIndeterminate="True" Visibility="Collapsed"/>

        <Border Grid.Row="2" Style="{StaticResource PageCard}" Margin="0,12,0,0">
            <TabControl x:Name="CleanupTabs" Background="Transparent" BorderThickness="0"
                        SelectionChanged="CleanupTabs_SelectionChanged">
                <TabItem x:Name="EmptyTab" Header="空文件夹">
                    <ListView x:Name="EmptyList" Margin="0,8,0,0"
                              Background="Transparent" BorderThickness="0"
                              ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListView.View>
                            <GridView>
                                <GridViewColumn Header="执行" Width="44">
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate>
                                            <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                                      Style="{StaticResource FileTabs.RowCheckBox}"
                                                      HorizontalAlignment="Center"
                                                      Checked="RowCheck_Changed"
                                                      Unchecked="RowCheck_Changed"/>
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>
                                <GridViewColumn Header="相对路径" Width="300"
                                                DisplayMemberBinding="{Binding Path}"/>
                                <GridViewColumn Header="大小" Width="80"
                                                DisplayMemberBinding="{Binding SizeText}"/>
                                <GridViewColumn Header="修改时间" Width="130"
                                                DisplayMemberBinding="{Binding ModifiedText}"/>
                            </GridView>
                        </ListView.View>
                    </ListView>
                </TabItem>

                <TabItem x:Name="LargestTab" Header="大文件">
                    <ListView x:Name="LargestList" Margin="0,8,0,0"
                              Background="Transparent" BorderThickness="0"
                              ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListView.View>
                            <GridView>
                                <GridViewColumn Header="执行" Width="44">
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate>
                                            <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                                      Style="{StaticResource FileTabs.RowCheckBox}"
                                                      HorizontalAlignment="Center"
                                                      Checked="RowCheck_Changed"
                                                      Unchecked="RowCheck_Changed"/>
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>
                                <GridViewColumn Header="相对路径" Width="300"
                                                DisplayMemberBinding="{Binding Path}"/>
                                <GridViewColumn Header="大小" Width="80"
                                                DisplayMemberBinding="{Binding SizeText}"/>
                                <GridViewColumn Header="修改时间" Width="130"
                                                DisplayMemberBinding="{Binding ModifiedText}"/>
                            </GridView>
                        </ListView.View>
                    </ListView>
                </TabItem>

                <TabItem x:Name="StaleTab" Header="超期文件">
                    <ListView x:Name="StaleList" Margin="0,8,0,0"
                              Background="Transparent" BorderThickness="0"
                              ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListView.View>
                            <GridView>
                                <GridViewColumn Header="执行" Width="44">
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate>
                                            <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                                      Style="{StaticResource FileTabs.RowCheckBox}"
                                                      HorizontalAlignment="Center"
                                                      Checked="RowCheck_Changed"
                                                      Unchecked="RowCheck_Changed"/>
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>
                                <GridViewColumn Header="相对路径" Width="300"
                                                DisplayMemberBinding="{Binding Path}"/>
                                <GridViewColumn Header="大小" Width="80"
                                                DisplayMemberBinding="{Binding SizeText}"/>
                                <GridViewColumn Header="修改时间" Width="130"
                                                DisplayMemberBinding="{Binding ModifiedText}"/>
                            </GridView>
                        </ListView.View>
                    </ListView>
                </TabItem>
            </TabControl>
        </Border>

        <Grid Grid.Row="3" Margin="0,14,0,0">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                <Button x:Name="ToggleSelectButton" Content="全选/取消全选"
                        Click="ToggleSelect_Click"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="CancelButton" Content="取消扫描" Margin="0,0,8,0"
                        Visibility="Collapsed" Click="Cancel_Click"/>
                <Button x:Name="DeleteButton" Content="删除选中项…" Width="120"
                        IsEnabled="False" Click="Delete_Click"/>
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>
