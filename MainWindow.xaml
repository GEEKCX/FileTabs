<ui:FluentWindow x:Class="FileTabs.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        Title="FileTabs" Height="640" Width="1000" MinHeight="320" MinWidth="520"
        ExtendsContentIntoTitleBar="True"
        WindowBackdropType="None"
        Background="{DynamicResource SolidBackgroundFillColorBaseBrush}"
        FontFamily="{x:Static SystemFonts.MessageFontFamily}"
        FontSize="{x:Static SystemFonts.MessageFontSize}"
    UseLayoutRounding="True"
    TextOptions.TextFormattingMode="Display"
    TextOptions.TextRenderingMode="ClearType">
    <Window.Resources>
        <!-- Tab close glyph: invisible until hovered, red on hover like the
             native caption close button. -->
        <Style x:Key="TabCloseButton" TargetType="Button" BasedOn="{StaticResource Fluent.IconButton}">
            <Setter Property="Width" Value="20"/>
            <Setter Property="Height" Value="20"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bg" Background="Transparent" CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bg" Property="Background"
                                        Value="{DynamicResource PaletteRedBrush}"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <DockPanel>
        <!-- Rename popup: zero-size in layout, shown near the mouse -->
        <Popup x:Name="RenamePopup" Placement="Mouse" StaysOpen="False" AllowsTransparency="True">
            <Border Background="{DynamicResource ContextMenuBackground}"
                    BorderBrush="{DynamicResource ContextMenuBorderBrush}"
                    BorderThickness="1" CornerRadius="8" Padding="6">
                <StackPanel Orientation="Horizontal">
                    <TextBox x:Name="RenameBox" Width="180" FontSize="12" KeyDown="RenameBox_KeyDown"/>
                    <Button Content="确定" Width="48" Margin="6,0,0,0" Click="RenameOk_Click"/>
                    <Button Content="取消" Width="48" Margin="4,0,0,0" Click="RenameCancel_Click"/>
                </StackPanel>
            </Border>
        </Popup>

        <!-- Menu popup: zero-size, so it must not be the DockPanel's last child
             (LastChildFill would hand the remaining space to it). -->
        <Popup x:Name="MenuPopup" PlacementTarget="{Binding ElementName=MenuButton}"
               Placement="Bottom" StaysOpen="False" AllowsTransparency="True"
               PopupAnimation="Fade"
               IsOpen="{Binding IsChecked, ElementName=MenuButton, Mode=TwoWay}">
            <Border Background="{DynamicResource ContextMenuBackground}"
                    BorderBrush="{DynamicResource ContextMenuBorderBrush}"
                    BorderThickness="1" CornerRadius="8" Padding="4" MinWidth="160">
                <StackPanel>
                    <MenuItem Header="设置" Click="Settings_Click" Padding="10,4" MinWidth="150"/>
                    <Separator/>
                    <MenuItem Header="保存工作区" InputGestureText="Ctrl+S" Click="SaveWorkspace_Click" Padding="10,4" MinWidth="150"/>
                    <MenuItem Header="打开工作区" InputGestureText="Ctrl+O" Click="OpenWorkspace_Click" Padding="10,4" MinWidth="150"/>
                </StackPanel>
            </Border>
        </Popup>

        <!-- 标题区沿用 360 文件夹的浅蓝灰底、紧凑白标签和右侧标签列表按钮。
             ui:TitleBar 继续负责标题栏拖动、双击最大化和系统窗口按钮。 -->
        <ui:TitleBar x:Name="MainTitleBar" DockPanel.Dock="Top" Height="36" ShowHelp="False"
                     Background="{DynamicResource FileTabs.ChromeFillBrush}">
            <ui:TitleBar.Header>
                <Border x:Name="TabBar" Background="Transparent" Margin="6,0,0,0"
                        MouseDown="TabStripBackground_MouseDown"
                        MouseRightButtonUp="TabStrip_RightButtonUp"
                        PreviewMouseMove="TabStrip_PreviewMouseMove"
                        MouseLeftButtonUp="TabStrip_MouseLeftButtonUp">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <ToggleButton x:Name="MenuButton" Width="30" Height="30"
                                      Margin="0,0,4,0" VerticalAlignment="Center"
                                      Focusable="False" ToolTip="菜单">
                            <ui:SymbolIcon Symbol="Navigation20" FontSize="14"/>
                        </ToggleButton>
                        <Grid Grid.Column="1">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <!-- 标签条和 + 分列摆放：标签区止于按钮左边缘，
                                 最后一块标签的 8px 反向外圆弧才不会被按钮底色盖住。
                                 标签过多时在列内裁切。 -->
                            <ItemsControl x:Name="TabStrip" Grid.Column="0" ClipToBounds="True">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <!-- 左侧留 8px 给第一块标签的反向外圆弧。 -->
                                    <StackPanel Orientation="Horizontal" Margin="8,0,0,0"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemContainerStyle>
                                <Style TargetType="ContentPresenter">
                                    <Style.Triggers>
                                        <!-- Keep the active tab visually on top of its neighbors -->
                                        <DataTrigger Binding="{Binding IsActive}" Value="True">
                                            <Setter Property="Panel.ZIndex" Value="10"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </ItemsControl.ItemContainerStyle>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <!-- 所有标签统一宽度，随窗口宽度自适应（UpdateTabWidth）。 -->
                                    <Grid x:Name="TabRoot" Height="30"
                                          Width="{Binding TabWidth, RelativeSource={RelativeSource AncestorType={x:Type Window}}}"
                                          MinWidth="64" MaxWidth="240"
                                          Margin="0,6,0,0" VerticalAlignment="Bottom"
                                          Background="Transparent"
                                          MouseDown="TabItem_MouseDown"
                                          MouseRightButtonUp="TabItem_RightButtonUp"
                                          ToolTip="{Binding Title}">
                                        <Grid.ContextMenu>
                                            <ContextMenu>
                                                <MenuItem Header="固定标签页" IsCheckable="True"
                                                          IsChecked="{Binding IsPinned, Mode=TwoWay}"
                                                          Click="TabPin_Click"/>
                                                <Separator/>
                                                <MenuItem Header="关闭" Click="TabClose_Click"/>
                                                <MenuItem Header="关闭其他标签页" Click="TabCloseOthers_Click"/>
                                                <MenuItem Header="关闭右侧标签页" Click="TabCloseRight_Click"/>
                                                <Separator/>
                                                <MenuItem Header="复制此标签页" Click="TabDuplicate_Click"/>
                                            </ContextMenu>
                                        </Grid.ContextMenu>
                                        <Border x:Name="TabBorder" Padding="0"
                                                CornerRadius="6,6,0,0"
                                                Background="{DynamicResource FileTabs.TabInactiveBrush}">
                                            <!-- 关闭按钮浮在标题右端而不是占一列：标签统一宽度后，
                                                 隐藏状态不再白占 20px，标题能多显示几个字。 -->
                                            <Grid Margin="7,0,3,0">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <!-- 普通文件夹用黄色文件夹图形；特殊 Shell 位置
                                                     用对应图标，文字色跟随标题区主题。 -->
                                                <Grid Width="17" Height="16" Margin="0,0,6,0"
                                                      VerticalAlignment="Center">
                                                    <Path x:Name="TabFolderIcon" Style="{StaticResource FileTabs.TabFolderIcon}"/>
                                                    <ui:SymbolIcon x:Name="TabSymbolIcon" Symbol="Folder24"
                                                                   FontSize="13" Visibility="Collapsed"
                                                                   Foreground="{DynamicResource FileTabs.ChromeMutedTextBrush}"/>
                                                </Grid>
                                                <TextBlock Grid.Column="1" Text="{Binding Title}" VerticalAlignment="Center"
                                                           Margin="0,0,2,0" FontSize="12.5"
                                                           TextTrimming="CharacterEllipsis"
                                                           Foreground="{DynamicResource FileTabs.ChromeTextBrush}"/>
                                                <Button x:Name="CloseButton" Grid.Column="1"
                                                        Style="{StaticResource TabCloseButton}"
                                                        Width="18" Height="18" Margin="0,0,-3,0"
                                                        HorizontalAlignment="Right" VerticalAlignment="Center"
                                                        Visibility="Hidden"
                                                        Click="TabClose_Click">
                                                    <ui:SymbolIcon Symbol="Dismiss16" FontSize="9"/>
                                                </Button>
                                            </Grid>
                                        </Border>
                                        <!-- 原有的外圆角标签造型：底部两个反向圆弧把标签和标题区
                                             连成一体，相邻标签共用这条曲线；激活标签不透明，
                                             画在最后，压住邻居的弧线，形成 Chrome 式波浪底边。 -->
                                        <Path x:Name="ScoopLeft" Width="8" Height="8"
                                              HorizontalAlignment="Left" VerticalAlignment="Bottom"
                                              Margin="-8,0,0,0" IsHitTestVisible="False"
                                              Fill="{Binding Background, ElementName=TabBorder}"
                                              Data="M 8,0 A 8,8 0 0 1 0,8 L 8,8 Z"/>
                                        <Path x:Name="ScoopRight" Width="8" Height="8"
                                              HorizontalAlignment="Right" VerticalAlignment="Bottom"
                                              Margin="0,0,-8,0" IsHitTestVisible="False"
                                              Fill="{Binding Background, ElementName=TabBorder}"
                                              Data="M 0,0 A 8,8 0 0 0 8,8 L 0,8 Z"/>
                                    </Grid>
                                    <DataTemplate.Triggers>
                                        <Trigger SourceName="TabRoot" Property="IsMouseOver" Value="True">
                                            <Setter TargetName="TabBorder" Property="Background"
                                                    Value="{DynamicResource FileTabs.ChromeHoverBrush}"/>
                                            <Setter TargetName="CloseButton" Property="Visibility" Value="Visible"/>
                                        </Trigger>
                                        <DataTrigger Binding="{Binding IsActive}" Value="True">
                                            <Setter TargetName="TabBorder" Property="Background"
                                                    Value="{DynamicResource FileTabs.TabActiveBrush}"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding IsPinned}" Value="True">
                                            <Setter TargetName="CloseButton" Property="Visibility" Value="Collapsed"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding TabKind}" Value="Computer">
                                            <Setter TargetName="TabFolderIcon" Property="Visibility" Value="Collapsed"/>
                                            <Setter TargetName="TabSymbolIcon" Property="Visibility" Value="Visible"/>
                                            <Setter TargetName="TabSymbolIcon" Property="Symbol" Value="Desktop24"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding TabKind}" Value="Network">
                                            <Setter TargetName="TabFolderIcon" Property="Visibility" Value="Collapsed"/>
                                            <Setter TargetName="TabSymbolIcon" Property="Visibility" Value="Visible"/>
                                            <Setter TargetName="TabSymbolIcon" Property="Symbol" Value="Globe24"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding TabKind}" Value="RecycleBin">
                                            <Setter TargetName="TabFolderIcon" Property="Visibility" Value="Collapsed"/>
                                            <Setter TargetName="TabSymbolIcon" Property="Visibility" Value="Visible"/>
                                            <Setter TargetName="TabSymbolIcon" Property="Symbol" Value="Delete24"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding TabKind}" Value="Library">
                                            <Setter TargetName="TabFolderIcon" Property="Visibility" Value="Collapsed"/>
                                            <Setter TargetName="TabSymbolIcon" Property="Visibility" Value="Visible"/>
                                            <Setter TargetName="TabSymbolIcon" Property="Symbol" Value="Library24"/>
                                        </DataTrigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                            <Button x:Name="NewTabButton" Grid.Column="1" Width="28" Height="30" Padding="0"
                                    Style="{StaticResource Fluent.IconButton}"
                                    Margin="2,6,0,0" VerticalAlignment="Bottom"
                                    Click="NewTab_Click" ToolTip="New tab (Ctrl+T)">
                                <ui:SymbolIcon Symbol="Add20" FontSize="13"/>
                            </Button>
                        </Grid>
                    </Grid>
                </Border>
            </ui:TitleBar.Header>
            <!-- 标签页列表按钮贴在系统窗口按钮左侧：Header 只占内容宽度，
                 只有 TrailingContent 会一路右对齐到最小化按钮前面。 -->
            <ui:TitleBar.TrailingContent>
                <Button x:Name="TabListButton" Width="30" Height="28" Padding="0"
                        Style="{StaticResource Fluent.IconButton}"
                        VerticalAlignment="Center" Margin="0,0,6,0"
                        Click="TabListButton_Click" ToolTip="标签页列表">
                    <StackPanel Orientation="Horizontal">
                        <ui:SymbolIcon Symbol="ChevronDown20" FontSize="11"/>
                        <TextBlock x:Name="TabCountText" Text="0" FontSize="11" Margin="2,0,0,0"
                                   VerticalAlignment="Center"/>
                    </StackPanel>
                    <Button.ContextMenu>
                        <ContextMenu x:Name="TabListMenu" Placement="Bottom"
                                     PlacementTarget="{Binding ElementName=TabListButton}"
                                     Opened="TabListMenu_Opened"/>
                    </Button.ContextMenu>
                </Button>
            </ui:TitleBar.TrailingContent>
        </ui:TitleBar>

        <!-- 两行命令区：上排文件操作，下排完整地址栏与搜索。 -->
        <Border DockPanel.Dock="Top" Background="{DynamicResource SolidBackgroundFillColorBaseBrush}"
                BorderBrush="{DynamicResource FileTabs.DividerBrush}"
                BorderThickness="0,0,0,1">
            <Grid Margin="8,4,8,5">
                <Grid.RowDefinitions>
                    <RowDefinition Height="30"/>
                    <RowDefinition Height="4"/>
                    <RowDefinition Height="32"/>
                </Grid.RowDefinitions>
                <Grid Grid.Row="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                <!-- Native shell views (This PC, Libraries) place their own
                     command bar inside the view; this is the same set of
                     view choices in one place for every folder. -->
                    <Button x:Name="ViewModeButton" Style="{StaticResource FileTabs.CommandButton}"
                            Click="ViewModeButton_Click" ToolTip="视图">
                        <Button.ContextMenu>
                            <ContextMenu x:Name="ViewMenu" Placement="Bottom"
                                         PlacementTarget="{Binding ElementName=ViewModeButton}"
                                         Opened="ViewMenu_Opened">
                                <MenuItem Header="详细信息" Tag="Details" IsCheckable="True" Click="ViewModeMenuItem_Click"/>
                                <MenuItem Header="列表" Tag="List" IsCheckable="True" Click="ViewModeMenuItem_Click"/>
                                <MenuItem Header="小图标" Tag="SmallIcon" IsCheckable="True" Click="ViewModeMenuItem_Click"/>
                                <MenuItem Header="中图标" Tag="Icon" IsCheckable="True" Click="ViewModeMenuItem_Click"/>
                                <MenuItem Header="大图标" Tag="LargeIcon" IsCheckable="True" Click="ViewModeMenuItem_Click"/>
                                <MenuItem Header="超大图标" Tag="ExtraLargeIcon" IsCheckable="True" Click="ViewModeMenuItem_Click"/>
                                <MenuItem Header="平铺" Tag="Tile" IsCheckable="True" Click="ViewModeMenuItem_Click"/>
                                <MenuItem Header="内容" Tag="Content" IsCheckable="True" Click="ViewModeMenuItem_Click"/>
                                <Separator/>
                                <MenuItem x:Name="ShowDetailsPaneMenuItem"
                                          Header="详细信息窗格"
                                          IsCheckable="True"
                                          Checked="ShowDetailsPane_Changed"
                                          Unchecked="ShowDetailsPane_Changed"/>
                                <MenuItem x:Name="ShowPreviewPaneMenuItem"
                                          Header="预览窗格"
                                          IsCheckable="True"
                                          Checked="ShowPreviewPane_Changed"
                                          Unchecked="ShowPreviewPane_Changed"/>
                            </ContextMenu>
                        </Button.ContextMenu>
                        <ui:SymbolIcon Symbol="PanelRight20" FontSize="18"/>
                    </Button>
                    <Button x:Name="NewFolderButton" Style="{StaticResource FileTabs.CommandButton}"
                            Click="NewFolderButton_Click" ToolTip="新建文件夹">
                        <ui:SymbolIcon Symbol="FolderAdd24" FontSize="18"/>
                    </Button>
                    <Border Style="{StaticResource FileTabs.CommandSeparator}"/>
                    <Button x:Name="CutButton" Style="{StaticResource FileTabs.CommandButton}"
                            Click="CutButton_Click" ToolTip="剪切">
                        <ui:SymbolIcon Symbol="Cut24" FontSize="18"/>
                    </Button>
                    <Button x:Name="CopyButton" Style="{StaticResource FileTabs.CommandButton}"
                            Click="CopyButton_Click" ToolTip="复制">
                        <ui:SymbolIcon Symbol="Copy24" FontSize="18"/>
                    </Button>
                    <Button x:Name="PasteButton" Style="{StaticResource FileTabs.CommandButton}"
                            Click="PasteButton_Click" ToolTip="粘贴">
                        <ui:SymbolIcon Symbol="ClipboardPaste24" FontSize="18"/>
                    </Button>
                    <Button x:Name="DeleteButton" Style="{StaticResource FileTabs.CommandButton}"
                            Click="DeleteButton_Click" ToolTip="删除到回收站">
                        <ui:SymbolIcon Symbol="Delete24" FontSize="18"/>
                    </Button>
                    <Border Style="{StaticResource FileTabs.CommandSeparator}"/>
                    <Button x:Name="TerminalButton" Style="{StaticResource FileTabs.CommandButton}"
                            Click="OpenTerminal_Click" ToolTip="在终端打开">
                        <ui:SymbolIcon Symbol="WindowConsole20" FontSize="18"/>
                    </Button>
                    <Button x:Name="PropertiesButton" Style="{StaticResource FileTabs.CommandButton}"
                            Click="PropertiesButton_Click" ToolTip="属性">
                        <ui:SymbolIcon Symbol="Info24" FontSize="18"/>
                    </Button>
                    </StackPanel>
                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button x:Name="ToolbarMenuButton" Style="{StaticResource FileTabs.CommandButton}"
                                Click="ToolbarMenuButton_Click"
                                ToolTip="更多操作">
                        <!-- The menu must hang off an element's ContextMenu property:
                             a ContextMenu placed directly in a panel's children throws
                             "ContextMenu cannot have a logical or visual parent". -->
                        <Button.ContextMenu>
                            <ContextMenu x:Name="ToolbarMenu" Placement="Bottom"
                                         PlacementTarget="{Binding ElementName=ToolbarMenuButton}">
                                <MenuItem x:Name="ReopenClosedTabMenuItem"
                                          Header="撤销关闭标签页"
                                          InputGestureText="Ctrl+Shift+T"
                                          Click="ReopenClosedTab_Click"
                                          Padding="10,4" MinWidth="180"/>
                                <Separator/>
                                <MenuItem x:Name="ShowBookmarkBarMenuItem"
                                          Header="显示书签栏"
                                          IsCheckable="True"
                                          Checked="ShowBookmarkBar_Changed"
                                          Unchecked="ShowBookmarkBar_Changed"
                                          Padding="10,4" MinWidth="180"/>
                                <MenuItem x:Name="ShowNativeSidebarMenuItem"
                                          Header="显示原生侧边栏"
                                          IsCheckable="True"
                                          Checked="ShowNativeSidebar_Changed"
                                          Unchecked="ShowNativeSidebar_Changed"
                                          Padding="10,4" MinWidth="180"/>
                                <MenuItem x:Name="ShowNativeCommandBarMenuItem"
                                          Header="显示原生命令栏"
                                          IsCheckable="True"
                                          Checked="ShowNativeCommandBar_Changed"
                                          Unchecked="ShowNativeCommandBar_Changed"
                                          Padding="10,4" MinWidth="180"/>
                                <Separator/>
                                <MenuItem x:Name="OpenTerminalMenuItem"
                                          Header="在终端打开"
                                          Click="OpenTerminal_Click"
                                          Padding="10,4" MinWidth="180"/>
                                <MenuItem Header="设置" Click="Settings_Click"
                                          Padding="10,4" MinWidth="180"/>
                            </ContextMenu>
                        </Button.ContextMenu>
                        <ui:SymbolIcon Symbol="MoreHorizontal20" FontSize="18"/>
                    </Button>
                    <Button x:Name="DropPointButton" Style="{StaticResource FileTabs.CommandButton}"
                            Click="DropPointButton_Click"
                            ToolTip="DropPoint 拖放中转 (Shift+CapsLock)">
                        <ui:SymbolIcon Symbol="Drag24" FontSize="18"/>
                    </Button>
                    <Button x:Name="RecentLocationsButton" Style="{StaticResource FileTabs.CommandButton}"
                            Click="RecentLocationsButton_Click"
                            ToolTip="最近访问 (Ctrl+H)">
                        <ui:SymbolIcon Symbol="History20" FontSize="18"/>
                    </Button>
                    <ui:Button x:Name="AiButton" Height="30" Appearance="Transparent"
                               Margin="6,0,2,0" Padding="7,0"
                               Click="AiButton_Click" ToolTip="AI 助手">
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon Symbol="Sparkle24" FontSize="13" Foreground="#3A7CB8"/>
                            <TextBlock Text="AI" Margin="3,0,0,0" FontSize="12"
                                       Foreground="{DynamicResource FileTabs.ChromeMutedTextBrush}"/>
                        </StackPanel>
                    </ui:Button>
                </StackPanel>
                </Grid>

                <!-- 第二行：导航按钮 + 地址 + 搜索。 -->
                <DockPanel Grid.Row="2">
                    <Button x:Name="BackButton" DockPanel.Dock="Left"
                            Style="{StaticResource FileTabs.CommandButton}"
                            Click="Back_Click" ToolTip="后退">
                        <ui:SymbolIcon Symbol="ArrowLeft24" FontSize="18"/>
                    </Button>
                    <Button x:Name="ForwardButton" DockPanel.Dock="Left"
                            Style="{StaticResource FileTabs.CommandButton}"
                            Click="Forward_Click" ToolTip="前进">
                        <ui:SymbolIcon Symbol="ArrowRight24" FontSize="18"/>
                    </Button>
                    <Button x:Name="UpButton" DockPanel.Dock="Left"
                            Style="{StaticResource FileTabs.CommandButton}"
                            Click="Up_Click" ToolTip="上一级">
                        <ui:SymbolIcon Symbol="ArrowUp24" FontSize="18"/>
                    </Button>
                    <Border DockPanel.Dock="Left" Style="{StaticResource FileTabs.CommandSeparator}"/>
                    <StackPanel x:Name="SearchPanel" DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <ui:TextBox x:Name="SearchBox"
                                Width="228" Height="32"
                                IconPlacement="Left"
                                Icon="{ui:SymbolIcon Symbol=Search20, FontSize=14}"
                                PlaceholderText="在此电脑中搜索"
                                ClearButtonEnabled="True"
                                VerticalContentAlignment="Center"
                                ToolTip="Everything search"
                                TextChanged="SearchBox_TextChanged" KeyDown="SearchBox_KeyDown"/>
                    <!-- 窄窗口时藏起搜索框，只留这个搜索图标。 -->
                </StackPanel>
                    <Button x:Name="SearchToggleButton" DockPanel.Dock="Right" Width="30" Height="30" Padding="0"
                            Style="{StaticResource FileTabs.IconButtonBase}"
                            Click="SearchToggleButton_Click"
                            ToolTip="搜索 (Ctrl+F)">
                        <ui:SymbolIcon Symbol="Search20" FontSize="14"/>
                    </Button>
                <Popup x:Name="RecentLocationsPopup" PlacementTarget="{Binding ElementName=RecentLocationsButton}"
                       Placement="Bottom" StaysOpen="False" AllowsTransparency="True">
                    <Border Background="{DynamicResource SolidBackgroundFillColorBaseBrush}"
                            BorderBrush="{DynamicResource DividerStrokeColorDefaultBrush}"
                            BorderThickness="1" CornerRadius="8" Width="360" Padding="6">
                        <StackPanel>
                            <ListBox x:Name="RecentLocationsList" BorderThickness="0" Background="Transparent"
                                     PreviewMouseLeftButtonUp="RecentLocationsList_PreviewMouseLeftButtonUp"
                                     PreviewKeyDown="RecentLocationsList_PreviewKeyDown">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Margin="6,4" ToolTip="{Binding Path}">
                                            <TextBlock Text="{Binding DisplayTitle}"
                                                       TextTrimming="CharacterEllipsis"
                                                       Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                                            <TextBlock Text="{Binding VisitedAtText}"
                                                       FontSize="{x:Static SystemFonts.MessageFontSize}"
                                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                            <ui:Button Content="打开历史记录" HorizontalAlignment="Stretch" Margin="6,6,0,0"
                                       Click="RecentLocationsOpenFullPage_Click"/>
                        </StackPanel>
                    </Border>
                </Popup>
                <Popup x:Name="SearchHintPopup" PlacementTarget="{Binding ElementName=SearchBox}" Placement="Bottom"
                       StaysOpen="False" AllowsTransparency="True">
                    <Border Background="{DynamicResource SystemFillColorCautionBackgroundBrush}"
                            BorderBrush="{DynamicResource SystemFillColorCautionBrush}"
                            BorderThickness="1" CornerRadius="8" Padding="6,3">
                        <TextBlock x:Name="SearchHintText"
                                   Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                    </Border>
                </Popup>
                <Popup x:Name="AddressSuggestPopup" PlacementTarget="{Binding ElementName=AddressBox}"
                       Placement="Bottom" StaysOpen="True" AllowsTransparency="True">
                    <Border x:Name="AddressSuggestContent"
                            Width="{Binding ActualWidth, ElementName=AddressBox}"
                            Background="{DynamicResource SolidBackgroundFillColorBaseBrush}"
                            BorderBrush="{DynamicResource DividerStrokeColorDefaultBrush}"
                            BorderThickness="1" CornerRadius="8" Padding="4">
                        <ListBox x:Name="AddressSuggestList" BorderThickness="0" Background="Transparent"
                                 MaxHeight="360"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                 ScrollViewer.VerticalScrollBarVisibility="Auto"
                                 PreviewMouseLeftButtonUp="AddressSuggestList_PreviewMouseLeftButtonUp">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Margin="6,3" ToolTip="{Binding Path}">
                                        <TextBlock Text="{Binding Name}"
                                                   Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                                   TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Text="{Binding Path}"
                                                   FontSize="{x:Static SystemFonts.MessageFontSize}"
                                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                   TextTrimming="CharacterEllipsis"/>
                                    </StackPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Border>
                </Popup>

                <!-- Breadcrumb path editor: inline path segments when not editing;
                     swap in the plain TextBox on focus / Escape. -->
                <Grid x:Name="AddressArea" VerticalAlignment="Center" Margin="0,0,8,0" MinWidth="120">
                    <Border x:Name="AddressFrame" Height="32"
                            Background="{DynamicResource FileTabs.FieldFillBrush}"
                            BorderBrush="{DynamicResource FileTabs.DividerBrush}"
                            BorderThickness="1" CornerRadius="4">
                    <Grid>
                    <!-- 地址栏末尾的刷新与复制路径；两者都盖在面包屑之上，
                         不会挤占路径可显示的长度。 -->
                    <Border x:Name="AddressTail" HorizontalAlignment="Right"
                            Margin="0,0,2,0" Padding="4,0,2,0"
                            VerticalAlignment="Stretch"
                            Background="{DynamicResource FileTabs.FieldFillBrush}">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Button x:Name="CopyPathButton" Width="22" Height="22" Padding="1" Margin="0,0,1,0"
                                    Style="{StaticResource FileTabs.IconButtonBase}"
                                    Click="CopyAddress_Click" ToolTip="复制当前路径">
                                <ui:SymbolIcon Symbol="Copy20" FontSize="11"/>
                            </Button>
                            <Button x:Name="RefreshButton" Width="24" Height="24" Padding="0"
                                    Style="{StaticResource FileTabs.IconButtonBase}"
                                    Click="Refresh_Click" ToolTip="刷新 (F5)">
                                <ui:SymbolIcon Symbol="ArrowClockwise20" FontSize="13"/>
                            </Button>
                        </StackPanel>
                    </Border>
                    <TextBox x:Name="AddressBox" Style="{StaticResource FileTabs.AddressBox}"
                             Visibility="Collapsed"
                             Padding="8,0,58,0"
                             TextChanged="AddressBox_TextChanged"
                             LostKeyboardFocus="AddressBox_LostKeyboardFocus"
                             PreviewKeyDown="AddressBox_PreviewKeyDown"
                             KeyDown="AddressBox_KeyDown"/>
                    <!-- 右侧留出 56px 给 AddressTail，避免长路径压到按钮下面。 -->
                    <Border x:Name="BreadcrumbBar" Background="Transparent" Padding="8,0,56,0"
                            MouseLeftButtonDown="BreadcrumbBar_MouseLeftButtonDown">
                        <Border.ContextMenu>
                            <ContextMenu>
                                <MenuItem Header="复制路径" Click="CopyAddress_Click"/>
                                <MenuItem Header="编辑地址" Click="EditAddress_Click"/>
                            </ContextMenu>
                        </Border.ContextMenu>
                        <ItemsControl x:Name="BreadcrumbItems" VerticalAlignment="Center">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="›" Foreground="{DynamicResource FileTabs.ChromeMutedTextBrush}"
                                                   VerticalAlignment="Center" Margin="0,0,4,0"/>
                                        <TextBlock Text="{Binding Label}"
                                                   Foreground="{DynamicResource FileTabs.ChromeTextBrush}"
                                                   VerticalAlignment="Center" Cursor="Hand"
                                                   MouseLeftButtonDown="BreadcrumbPart_Click"/>
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Border>
                    </Grid>
                    </Border>
                </Grid>
            </DockPanel>
            </Grid>
        </Border>

        <!-- 书签栏：底色与上方命令区共用同一个画刷（浅色为 #F3F3F3），
             黄色星形收藏标记，书签用文件夹图形和细竖线分隔。 -->
        <Border x:Name="BookmarkBar" DockPanel.Dock="Top"
                Background="{DynamicResource SolidBackgroundFillColorBaseBrush}"
                BorderBrush="{DynamicResource FileTabs.DividerBrush}"
                BorderThickness="0,0,0,1"
                AllowDrop="True" DragOver="BookmarkBar_DragOver" Drop="BookmarkBar_Drop"
                PreviewMouseMove="BookmarkStrip_PreviewMouseMove"
                MouseLeftButtonUp="BookmarkStrip_MouseLeftButtonUp">
            <DockPanel Height="32" Margin="8,0">
                <!-- 书签内容只占滚动区 32px 中的上面 28px，居中会低 2px；
                     这里按内容行中心（14px）定位，星形也比文件夹图标略小。 -->
                <Path DockPanel.Dock="Left" Width="12" Height="12" Margin="7,8,7,0"
                      VerticalAlignment="Top" Stretch="Uniform"
                      Fill="#F6B93B" Stroke="#E3A21C" StrokeThickness="0.6"
                      Data="M 8,1 L 10,5.7 L 15,6.3 L 11.4,9.6 L 12.4,14.6 L 8,12.1 L 3.6,14.6 L 4.6,9.6 L 1,6.3 L 6,5.7 Z"
                      ToolTip="收藏"/>
                <TextBlock DockPanel.Dock="Right" x:Name="BookmarkEmptyHint"
                           Text="可拖动文档、软件、文件夹到此，点击快速打开"
                           FontSize="11"
                           Foreground="{DynamicResource FileTabs.ChromeMutedTextBrush}"
                           VerticalAlignment="Center" Margin="4,0"/>
                <ScrollViewer x:Name="BookmarkScroll" Style="{StaticResource FileTabs.BookmarkScroll}">
                    <ItemsControl x:Name="BookmarkStrip">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal">
                                    <Border Style="{StaticResource FileTabs.BookmarkItem}"
                                            MouseDown="Bookmark_MouseDown" ToolTip="{Binding Path}">
                                        <Border.ContextMenu>
                                            <ContextMenu>
                                                <MenuItem Header="打开" Click="BookmarkOpen_Click"/>
                                                <MenuItem Header="在新标签页打开" Click="BookmarkOpenNewTab_Click"/>
                                                <MenuItem Header="打开所在位置" Click="BookmarkOpenContaining_Click"/>
                                                <Separator/>
                                                <MenuItem Header="重命名" Click="BookmarkRename_Click"/>
                                                <MenuItem Header="删除书签" Click="BookmarkDelete_Click"/>
                                            </ContextMenu>
                                        </Border.ContextMenu>
                                        <StackPanel Orientation="Horizontal">
                                            <Path x:Name="BookmarkIcon" Style="{StaticResource FileTabs.BookmarkIcon}"/>
                                            <TextBlock Text="{Binding Name}" FontSize="12"
                                                       MaxWidth="160" VerticalAlignment="Center"
                                                       MinWidth="0"
                                                       TextTrimming="CharacterEllipsis"
                                                       Foreground="{DynamicResource FileTabs.ChromeTextBrush}"/>
                                        </StackPanel>
                                    </Border>
                                    <Border Width="1" Height="14" Margin="4,0" VerticalAlignment="Center"
                                            Background="{DynamicResource FileTabs.DividerBrush}"/>
                                </StackPanel>
                                <DataTemplate.Triggers>
                                    <DataTrigger Binding="{Binding IsFolder}" Value="False">
                                        <Setter TargetName="BookmarkIcon" Property="Fill" Value="#E9EDF2"/>
                                        <Setter TargetName="BookmarkIcon" Property="Stroke" Value="#97A6B6"/>
                                        <Setter TargetName="BookmarkIcon" Property="StrokeThickness" Value="1"/>
                                    </DataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </DockPanel>
        </Border>

        <!-- Selection summary: the shell already draws its own bottom bar for
             the item count, but it cannot show total bytes for a selection.
             This row appears only while something is selected, so the two do
             not stack into a duplicate "N items" strip. -->
        <Border x:Name="StatusBar" DockPanel.Dock="Bottom" Height="26"
                Background="{DynamicResource SolidBackgroundFillColorBaseBrush}"
                BorderBrush="{DynamicResource DividerStrokeColorDefaultBrush}"
                BorderThickness="0,1,0,0"
                Visibility="Collapsed">
            <DockPanel Margin="12,0" LastChildFill="True">
                <TextBlock x:Name="StatusHintText" DockPanel.Dock="Right"
                           Margin="12,0,0,0"
                           VerticalAlignment="Center"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                <TextBlock x:Name="StatusText" VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis"
                           Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
            </DockPanel>
        </Border>

        <!-- Body: shell view on the left, Everything results panel on the right. -->
        <Grid x:Name="BodyGrid">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="5"/>
                <ColumnDefinition x:Name="SearchResultsColumn" Width="0" MinWidth="0"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition x:Name="BodyRow" Height="*"/>
                <RowDefinition x:Name="HistoryRow" Height="0"/>
            </Grid.RowDefinitions>

            <!-- one WindowsFormsHost per tab, stacked here; only active is visible -->
            <Grid x:Name="ViewContainer" Grid.Column="0"/>

            <!-- Access history drawer: takes the bottom 20% of the body,
                 leaving the active file view visible above it. -->
            <Border x:Name="HistoryPanel" Grid.Row="1" Grid.Column="0"
                    Background="{DynamicResource SolidBackgroundFillColorBaseBrush}"
                    BorderBrush="{DynamicResource DividerStrokeColorDefaultBrush}"
                    BorderThickness="0,1,0,0"
                    Visibility="Collapsed">
                <DockPanel Margin="12,8">
                    <Border DockPanel.Dock="Top" Padding="0,0,0,6"
                            BorderBrush="{DynamicResource DividerStrokeColorDefaultBrush}"
                            BorderThickness="0,0,0,1">
                        <DockPanel>
                            <ui:Button DockPanel.Dock="Right" Width="28" Height="28" Padding="0"
                                       Appearance="Transparent" Click="HistoryPageClose_Click"
                                       ToolTip="关闭历史记录">
                                <ui:SymbolIcon Symbol="Dismiss20" FontSize="12"/>
                            </ui:Button>
                            <ui:TextBox x:Name="HistorySearchBox" DockPanel.Dock="Right"
                                        Width="240" Height="28" Margin="8,0,0,0"
                                        VerticalContentAlignment="Center"
                                        PlaceholderText="搜索历史记录"
                                        TextChanged="HistorySearchBox_TextChanged"
                                        KeyDown="HistorySearchBox_KeyDown"/>
                            <TextBlock Text="历史记录" FontSize="16" FontWeight="SemiBold"
                                       VerticalAlignment="Center"
                                       Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                        </DockPanel>
                    </Border>
                    <Grid>
                        <ListBox x:Name="HistoryItems" BorderThickness="0" Background="Transparent"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                 PreviewMouseLeftButtonUp="HistoryItems_PreviewMouseLeftButtonUp"
                                 PreviewKeyDown="HistoryItems_PreviewKeyDown">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Border Padding="8,6">
                                        <StackPanel>
                                            <TextBlock Text="{Binding DisplayTitle}"
                                                       Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                                       TextTrimming="CharacterEllipsis"/>
                                            <TextBlock FontSize="{x:Static SystemFonts.MessageFontSize}"
                                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}">
                                                <TextBlock.Text>
                                                    <MultiBinding StringFormat="{}{0} · {1}">
                                                        <Binding Path="Path"/>
                                                        <Binding Path="VisitedAtText"/>
                                                    </MultiBinding>
                                                </TextBlock.Text>
                                            </TextBlock>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                        <TextBlock x:Name="HistoryEmptyHint" Text="暂无历史记录"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                   Visibility="Collapsed"/>
                    </Grid>
                </DockPanel>
            </Border>

            <GridSplitter x:Name="SearchPanelSplitter" Grid.Column="1"
                          Grid.RowSpan="2"
                          HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                          Background="Transparent" ShowsPreview="True"
                          ResizeBehavior="PreviousAndNext" ResizeDirection="Columns"
                          Visibility="Collapsed"/>

            <Border x:Name="SearchResultsPanel" Grid.Column="2"
                    Grid.RowSpan="2"
                    Background="{DynamicResource SolidBackgroundFillColorQuarternaryBrush}"
                    BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                    BorderThickness="1,0,0,0" Visibility="Collapsed">
                <DockPanel>
                    <Border DockPanel.Dock="Top" Padding="8,6"
                            Background="{DynamicResource SolidBackgroundFillColorBaseBrush}"
                            BorderBrush="{DynamicResource DividerStrokeColorDefaultBrush}"
                            BorderThickness="0,0,0,1">
                    <DockPanel LastChildFill="False">
                            <ui:Button DockPanel.Dock="Right" Width="24" Height="24" Padding="0"
                                    Appearance="Transparent"
                                    Click="SearchPanelClose_Click" ToolTip="关闭搜索结果">
                                <ui:SymbolIcon Symbol="Dismiss20" FontSize="11"/>
                            </ui:Button>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock x:Name="SearchResultCount"
                                       Text="0 个结果"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                       VerticalAlignment="Center" Margin="0,0,12,0"/>
                            <TextBlock Text="在 Everything 中打开"
                                       Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                       VerticalAlignment="Center" Cursor="Hand"
                                       MouseLeftButtonDown="OpenEverything_Click"/>
                        </StackPanel>
                        </DockPanel>
                    </Border>
                    <ListBox x:Name="SearchResults" BorderThickness="0" Background="Transparent"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             PreviewMouseLeftButtonDown="SearchResults_PreviewMouseDown"
                             PreviewKeyDown="SearchResults_PreviewKeyDown">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border Padding="8,6" Cursor="Hand" ToolTip="{Binding FullPath}">
                                    <StackPanel>
                                        <TextBlock Text="{Binding Name}"
                                                   Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                                   TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Text="{Binding Path}"
                                                   FontSize="{x:Static SystemFonts.MessageFontSize}"
                                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                   TextTrimming="CharacterEllipsis"/>
                                        <TextBlock FontSize="{x:Static SystemFonts.MessageFontSize}"
                                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}">
                                            <TextBlock.Text>
                                                <MultiBinding StringFormat="{}{0} · {1}">
                                                    <Binding Path="SizeText"/>
                                                    <Binding Path="ModifiedText"/>
                                                </MultiBinding>
                                            </TextBlock.Text>
                                        </TextBlock>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                        <ListBox.ContextMenu>
                            <ContextMenu>
                                <MenuItem Header="打开" Click="SearchResultOpen_Click"/>
                                <MenuItem Header="打开所在文件夹" Click="SearchResultOpenContaining_Click"/>
                                <MenuItem Header="复制完整路径" Click="SearchResultCopyPath_Click"/>
                            </ContextMenu>
                        </ListBox.ContextMenu>
                    </ListBox>
                </DockPanel>
            </Border>
        </Grid>

    </DockPanel>
</ui:FluentWindow>
