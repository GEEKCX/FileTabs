<Window x:Class="FileTabs.ExtensionsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        Title="FileTabs 扩展" Width="760" Height="650"
        MinWidth="620" MinHeight="480"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Background="{DynamicResource SolidBackgroundFillColorBaseBrush}"
        Foreground="{DynamicResource TextFillColorPrimaryBrush}"
        FontFamily="{x:Static SystemFonts.MessageFontFamily}"
        FontSize="{x:Static SystemFonts.MessageFontSize}">
    <Window.Resources>
        <Style x:Key="ExtensionCard" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource FileTabs.SettingsCardBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource FileTabs.SettingsCardBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="16"/>
        </Style>

        <Style x:Key="ExtensionSectionTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>

        <Style x:Key="ExtensionHint" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Margin" Value="0,4,0,0"/>
        </Style>
    </Window.Resources>

    <Grid Margin="20,16,20,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="44"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Border Width="38" Height="38" CornerRadius="8"
                    Background="{DynamicResource AccentFillColorDefaultBrush}"
                    HorizontalAlignment="Left" VerticalAlignment="Center">
                <ui:SymbolIcon Symbol="Apps24" FontSize="20"
                               Foreground="{DynamicResource TextOnAccentFillColorPrimaryBrush}"/>
            </Border>
            <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                <TextBlock Text="扩展中心" FontSize="20" FontWeight="SemiBold"/>
                <TextBlock Text="把重复的文件操作保存成可复用模板。"
                           Style="{StaticResource ExtensionHint}"/>
            </StackPanel>
        </Grid>

        <Grid Grid.Row="1" Margin="0,18,0,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="12"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Border Style="{StaticResource ExtensionCard}">
                <StackPanel>
                    <TextBlock Text="目录模板" Style="{StaticResource ExtensionSectionTitle}"/>
                    <Grid Margin="0,12,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="96"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <TextBlock Text="模板" VerticalAlignment="Center"/>
                        <ComboBox x:Name="TemplateCombo" Grid.Column="1"
                                  Height="34" Padding="8,0"
                                  VerticalContentAlignment="Center"
                                  DisplayMemberPath="Name"
                                  SelectionChanged="TemplateCombo_SelectionChanged"/>
                        <TextBlock x:Name="TemplateDescriptionText"
                                   Grid.Row="1" Grid.Column="1"
                                   Style="{StaticResource ExtensionHint}"
                                   Margin="0,4,0,0"/>

                        <TextBlock Grid.Row="2" Text="保存到" VerticalAlignment="Center"
                                   Margin="0,12,0,0"/>
                        <Grid Grid.Row="2" Grid.Column="1" Margin="0,12,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="RootPathBox" Height="32"
                                     TextChanged="RootPathBox_TextChanged"/>
                            <Button Grid.Column="1" Content="浏览…" Width="68" Height="32"
                                    Margin="8,0,0,0" Click="BrowseRoot_Click"/>
                        </Grid>

                        <TextBlock x:Name="InputLabelText" Grid.Row="3"
                                   Text="名称/编号" VerticalAlignment="Center"
                                   Margin="0,12,0,0"/>
                        <TextBox x:Name="ItemNumberBox" Grid.Row="3" Grid.Column="1"
                                 Height="32" Margin="0,12,0,0"
                                 TextChanged="ItemNumberBox_TextChanged"/>

                        <TextBlock Grid.Row="4" Grid.Column="1"
                                   Text="模板支持 {名称}、{日期}、{月份}；输入值不能包含 \ / : * ? &quot; &lt; &gt; |。"
                                   Style="{StaticResource ExtensionHint}"/>
                    </Grid>
                </StackPanel>
            </Border>

            <Border Grid.Row="2" Style="{StaticResource ExtensionCard}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <DockPanel>
                        <TextBlock Text="创建预览" Style="{StaticResource ExtensionSectionTitle}"/>
                        <TextBlock x:Name="PreviewStatusText"
                                   DockPanel.Dock="Right"
                                   HorizontalAlignment="Right"
                                   VerticalAlignment="Center"
                                   FontSize="12"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                    </DockPanel>
                    <TreeView x:Name="PreviewTree" Grid.Row="1"
                              Margin="0,8,0,0"
                              Background="Transparent"
                              BorderThickness="0"
                              Padding="4">
                        <TreeView.ItemTemplate>
                            <HierarchicalDataTemplate ItemsSource="{Binding Children}">
                                <StackPanel Orientation="Horizontal" Margin="0,2">
                                    <ui:SymbolIcon Symbol="Folder24" FontSize="14"
                                                   Margin="0,0,6,0" Foreground="#D6A536"/>
                                    <TextBlock Text="{Binding Name}" VerticalAlignment="Center"/>
                                    <TextBlock Text="{Binding Status}" Margin="8,0,0,0"
                                               VerticalAlignment="Center"
                                               FontSize="11"
                                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                </StackPanel>
                            </HierarchicalDataTemplate>
                        </TreeView.ItemTemplate>
                    </TreeView>
                </Grid>
            </Border>
        </Grid>

        <Grid Grid.Row="2" Margin="0,14,0,0">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                <Button x:Name="ManageTemplatesButton" Content="管理模板"
                        Click="ManageTemplates_Click"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="取消" Width="76" IsCancel="True"/>
                <Button x:Name="CreateButton" Content="创建文件夹" Width="108"
                        Margin="8,0,0,0" IsDefault="True"
                        IsEnabled="False" Click="CreateFolders_Click"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
